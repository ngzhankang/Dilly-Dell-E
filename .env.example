# Application
NODE_ENV=development
PORT=3001

# Database
MONGO_URI=mongodb://localhost:27017/hackathon
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace_me

# ML Service URL (consumed by backend to reach the ml-service)
# Local dev (backend on host):    http://localhost:8000
# Docker Compose / Kubernetes:    http://ml-service:8000
ML_SERVICE_URL=http://localhost:8000

# LLM — Primary: AISG API (tried first)
LLM_API_BASE_URL=https://api.aisingapore.org/v1
LLM_API_KEY=replace_me
LLM_MODEL=sea-lion-v3-instruct

# LLM — Fallback: Ollama self-hosted (used automatically when API fails)
# Local dev (Ollama on host):     http://localhost:11434
# Docker Compose / Kubernetes:    http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=aisingapore/llama3.1-8b-cpt-sea-lionv3-instruct

# Image registry (for make push-images)
REGISTRY=ghcr.io/your-org/dilly-dell-e
TAG=latest
