# Application
NODE_ENV=development
PORT=3001

# Database
MONGO_URI=mongodb://localhost:27017/hackathon
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace_me

# ML Service
# Local dev (backend running on host):  http://localhost:8000
# Docker Compose / Kubernetes:          http://ml-service:8000
ML_SERVICE_URL=http://localhost:8000
MODEL_PATH=/app/models/model.onnx

# Image registry (for make push-images)
REGISTRY=ghcr.io/your-org/dilly-dell-e
TAG=latest
